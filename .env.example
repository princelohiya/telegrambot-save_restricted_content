# Copy this file to `.env` and fill in your own values.

# From https://my.telegram.org -> "API development tools"
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# From @BotFather -> /newbot
BOT_TOKEN=1234567890:AAExampleTokenReplaceMe

# Output of `python generate_session.py` (Pyrogram session string of YOUR account)
SESSION_STRING=

# Optional — where media is staged before re-upload (default: ./downloads)
TEMP_DOWNLOAD_DIR=./downloads

# Optional tuning knobs
# QUEUE_MAX_SIZE=100
# DOWNLOAD_TIMEOUT=300
# UPLOAD_STALL_TIMEOUT=120
# MAX_FILE_SIZE=2147483648
